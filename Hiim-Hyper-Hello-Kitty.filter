// v24 core-first scoring: missing class-specific damage engine cannot be rescued by utility rolls.
Formula[V24SORCFIRE]: IF(AND(OR(ALLSK+CLSK1>=2,TABSK8>=3),MAX(SK47,SK51,SK52,SK56,SK62,SK376,SK383)>=2),1,0)
Formula[V24SORCCOLD]: IF(AND(OR(ALLSK+CLSK1>=2,TABSK10>=3),MAX(SK39,SK40,SK44,SK59,SK64,SK369,SK65)>=2),1,0)
Formula[V24SORCLIGHT]: IF(AND(OR(ALLSK+CLSK1>=2,TABSK9>=3),MAX(SK48,SK49,SK53,SK42,SK63)>=2),1,0)
Formula[V24SORCCORE]: IF(OR(AND(OR(ALLSK+CLSK1>=2,TABSK8>=3),MAX(SK47,SK51,SK52,SK56,SK62,SK376,SK383)>=2),AND(OR(ALLSK+CLSK1>=2,TABSK10>=3),MAX(SK39,SK40,SK44,SK59,SK64,SK369,SK65)>=2),AND(OR(ALLSK+CLSK1>=2,TABSK9>=3),MAX(SK48,SK49,SK53,SK42,SK63)>=2)),1,0)
Formula[V24DRUCORE]: IF(AND(OR(ALLSK+CLSK5>=2,TABSK42>=3,TABSK41>=3),OR(MAX(SK229,SK234,SK240,SK244,SK245,SK249,SK230)>=2,MAX(SK238,SK239,SK243)>=2)),1,0)
Formula[V24DRUCASTCORE]: IF(AND(OR(ALLSK+CLSK5>=2,TABSK42>=3),MAX(SK229,SK234,SK240,SK244,SK245,SK249,SK230)>=2),1,0)
Formula[V24DRUCASTPAYOFF]: IF(OR(AND(SK230>=2,OR(STAT335>=5,STAT331>=10)),AND(MAX(SK229,SK234,SK240,SK244,SK245,SK249)>=2,OR(STAT333>=5,STAT329>=10))),1,0)
Formula[V24NECCORE]: IF(OR(AND(OR(ALLSK+CLSK2>=2,TABSK17>=3),MAX(SK93,SK84,SK67)>=2),AND(OR(ALLSK+CLSK2>=2,TABSK16>=3),MAX(SK381)>=2)),1,0)
Formula[V24NECPAYOFF]: IF(OR(STAT336>=5,STAT332>=10,STAT337>=5,STAT328>=10),1,0)
Formula[V24PALCORE]: IF(AND(OR(ALLSK+CLSK3>=2,TABSK24>=3),MAX(SK112)>=2),1,0)
Formula[V24BARCASTCORE]: IF(AND(OR(ALLSK+CLSK4>=2,TABSK34>=3),MAX(SK146,SK149,SK154)>=2),1,0)
Formula[V24JAVMELEECORE]: IF(OR(ALLSK+CLSK0+TABSK2>=3,AND(EDAM>=275,IAS>=20),AND(ETH,EDAM>=400)),1,0)
