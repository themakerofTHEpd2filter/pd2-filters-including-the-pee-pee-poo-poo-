Alias[TAILORED_ETH_MARK]: %TEAL%[%WHITE%ETH%TEAL%]
Alias[TAILORED_PASTEL_GEAR]: ((RARE OR UNI OR CRAFT OR MAG) !MAPTIER>0)
Alias[TAILORED_MAX_SOCKET_SLAM]: (STAT360=32 SOCK>0 ((QUIVER $f(SOCK-MIN(MAXSOCKETS,2))=0) OR ((2H OR 7cr2) !QUIVER $f(SOCK-MIN(MAXSOCKETS,6))=0) OR (WEAPON !(2H OR 7cr2 OR QUIVER) $f(SOCK-MIN(MAXSOCKETS,4))=0) OR ((CHEST OR HELM OR CIRC OR SHIELD) !QUIVER $f(SOCK-MIN(MAXSOCKETS,3))=0)))
