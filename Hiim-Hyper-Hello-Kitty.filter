// Tailored ground visibility. The stock Level 0 fallback above remains available.
ItemDisplay[GROUND (GEM=4 OR gzvs OR glws OR glgs OR glrs OR glbs OR glys) !(skl OR skls)]:
// Shared set bases are resolved only after identification.
ItemDisplay[SET GROUND (bwn OR vgl)]:
ItemDisplay[SET GROUND ID cap MFIND>34]:
ItemDisplay[SET GROUND ID vbt FRW>39 AR>99 STAT49=0]:

// V42: Value-based identified rare retention independent of score.
Formula[TAILOREDPELTMAXSINGLE]: MAX(ALLSK+CLSK5+TABSK42+MAX(SK225,SK229,SK468,SK230,SK234,SK235,SK240,SK244,SK245,SK249,SK250),ALLSK+CLSK5+TABSK41+MAX(SK223,SK224,SK228,SK232,SK233,SK238,SK239,SK242,SK243,SK248),ALLSK+CLSK5+TABSK40+MAX(SK221,SK222,SK226,SK227,SK231,SK236,SK237,SK241,SK246,SK247))
// v48: A qualifying rare scoring 2.5+ is retained only on approved bases; explicit high-value keeps remain.
Alias[TAILORED_ID_KEEP_]: (RARE ID GROUND FILTLVL>0 ((WEAPON EDAM>299) OR (WEAPON EDAM>249 IAS>19) OR ((CHEST OR SHIELD) EDAM>179) OR (CIRC FCR>9 (CLSK1>1 OR CLSK2>1 OR CLSK3>1 OR CLSK6>1)) OR (CIRC FCR>19 (CLSK0>1 OR CLSK4>1 OR CLSK5>1)) OR (DRU FORMULATAILOREDPELTMAXSINGLE>5) OR ((CHEST OR SHIELD) SOCK>2 (EDAM>119 OR STAT36>11 OR MAX(CLSK0,CLSK1,CLSK2,CLSK3,CLSK4,CLSK5,CLSK6)>0)) OR ((CHEST OR SHIELD) FCR>19 (EDAM>119 OR STAT36>11 OR MAX(CLSK0,CLSK1,CLSK2,CLSK3,CLSK4,CLSK5,CLSK6)>0 OR (SOCK>1 RES>19))) OR (GLOVES IAS>19 (TABSK0>1 OR TABSK1>1 OR TABSK2>1 OR TABSK41>1 OR TABSK50>1)) OR (GLOVES FCR>19 (MAEK>1 OR STAT86>1)) OR (GLOVES IAS>19 EDAM>149 (STAT136>0 OR STAT141>0))) OR (TAILORED_SCORED_GEAR !rin !BELT !NEC !SIN (!WEAPON OR TAILORED_RARE_WEAPON_BASE_OK) (FORMULARARECASTERHUNDREDTHS>249 OR FORMULARAREMELEEHUNDREDTHS>249)) OR (BOOTS FRW>29 (FRES+CRES+LRES+PRES>99) (MFIND>0 OR FHR>0 OR GFIND>0)))
// Unidentified pelts use selective base logic; identified pelts must meet the v49 2.50 score floor.
// Show rare Druid pelts selectively instead of all thrown-back rares.
Alias[TAILORED_VISIBLE_PELT]: (DRU RARE GROUND FILTLVL>0 (!ID OR FORMULATAILOREDPELTMAXSINGLE>5 OR FORMULARARECASTERHUNDREDTHS>299 OR FORMULARAREMELEEHUNDREDTHS>299))
// v43: Rare boots with 30+ FRW, 100+ combined fire/cold/lightning/poison res, plus MF/FHR/GF are always retained after ID.
ItemDisplay[DRU !RARE GROUND FILTLVL~1-10]:
// Quietly hide weak identified rares only on the ground.
// Keep the existing specialist rules for ungraded boots and rare jewels.
ItemDisplay[TAILORED_SCORED_GEAR RARE !jew !INF GROUND FILTLVL~1-10 FORMULARARECASTERHUNDREDTHS<250 FORMULARAREMELEEHUNDREDTHS<250 !TAILORED_ID_KEEP_]:
// Hide ordinary gear in the Brandistock family. Named items keep their own rules.
ItemDisplay[GROUND (brn OR 9br OR 7br) !UNI !SET !RW !TAILORED_ID_KEEP_]:
// Superior combat bases must have 15% or more intrinsic damage or defense.
// Keep premium +3 skills and 45 all-res automods; ethereal chests have a 900-defense exception.
Alias[TAILORED_SUPERIOR_HEAVY_ARMOR]: (NMAG ETH CHEST !RW !INF !GEMMED DEF>899 (SOCK=0 OR SOCK=4))
Alias[TAILORED_SUPERIOR_BEST]: (((ED>14) ((7ga OR 7gi OR 7wa OR 7gd) (SOCK=0 OR SOCK~4-6))) OR ((ED>14) ETH (7gm OR 7wc OR 7s8 OR 7h7 OR 7p7) (SOCK=0 OR SOCK~4-6)) OR (ED>14 7cr (SOCK=0 OR SOCK~3-6)) OR ((amb OR amc) TABSK0>2 (SOCK=0 OR SOCK~3-5)) OR (ED>14 (6lb OR 6rx) (SOCK=0 OR SOCK~4-6)) OR (ED>14 !ETH (xtp OR utp OR uui OR ula) (SOCK=0 OR SOCK~2-4)) OR (ED>14 !ETH (uit OR uow) (SOCK=0 OR SOCK=4)) OR ((pab OR pac OR paf) RES>44 (SOCK=0 OR SOCK=3 OR SOCK=4)) OR (ED>14 (uh9 OR ci3) (SOCK=0 OR SOCK=3)) OR (6ws (SOCK=0 OR SOCK=4 OR SOCK=6) (SK44>2 OR SK47>2 OR SK48>2 OR SK49>2 OR SK56>2 OR SK59>2 OR SK64>2 OR SK369>2 OR SK376>2)) OR (7ws (SOCK=0 OR SOCK~3-5) (SK102>2 OR SK112>2 OR SK114>2 OR SK117>2 OR SK118>2 OR SK121>2 OR SK123>2)) OR ((7sp OR 7cl) (SOCK=0 OR SOCK=2 OR SOCK=3) (SK230>2 OR SK234>2 OR SK245>2 OR SK250>2)) OR ((7tw OR 7lw) (SOCK=0 OR SOCK=3) (SK262>2 OR SK271>2 OR SK272>2 OR SK366>2)) OR (amf ETH TABSK2>2 (SOCK=0 OR SOCK=3)))
ItemDisplay[SUP !RW GROUND !(TAILORED_SUPERIOR_BEST OR TAILORED_SUPERIOR_HEAVY_ARMOR) !TAILORED_VISIBLE_PELT]:

// Chase drops use every visible automap layer plus the rarest alert sound.
Alias[TAILORED_CHASE_SACRED]: %BORDER-D3%%MAP-9B%%DOT-0A%%PX-FF%%SOUNDID-4733%%PURPLE%<<<%CORAL%!!! %YELLOW%[[ %WHITE%SACRED ARMOR %YELLOW%]] %CORAL%!!!%PURPLE%>>>
Alias[TAILORED_CHASE_ZOD]: %BORDER-0A%%MAP-D3%%DOT-9B%%PX-FF%%SOUNDID-4733%%YELLOW%<<<%ORANGE%!!! %GOLD%[[ %WHITE%ZOD RUNE %GOLD%]] %ORANGE%!!!%YELLOW%>>>
Alias[TAILORED_CHASE_LIGHTSONG]: %BORDER-91%%MAP-7D%%DOT-D3%%PX-FF%%SOUNDID-4733%%TEAL%<<<%SAGE%!!! %YELLOW%[[ %WHITE%VIAL OF LIGHTSONG %YELLOW%]] %SAGE%!!!%TEAL%>>>
Alias[TAILORED_CHASE_MIRROR]: %BORDER-9B%%MAP-91%%DOT-0A%%PX-FF%%SOUNDID-4733%%PURPLE%<<<%CORAL%!!! %TEAL%[[ %WHITE%LILITH'S MIRROR %TEAL%]] %CORAL%!!!%PURPLE%>>>
ItemDisplay[TAILORED_GROUND_ED (uar UNI !ID ETH GROUND FILTLVL<11)]:%TAILORED_GROUND_ED_LABEL%%TAILORED_CHASE_SACRED%{%CORAL%Unidentified ethereal unique Sacred Armor%CL%%NAME%}
ItemDisplay[!TAILORED_GROUND_ED (uar UNI !ID ETH GROUND FILTLVL<11)]:%TAILORED_CHASE_SACRED%{%CORAL%Unidentified ethereal unique Sacred Armor%CL%%NAME%}
ItemDisplay[TAILORED_GROUND_ED (uar UNI !ID !ETH GROUND FILTLVL<11)]:%TAILORED_GROUND_ED_LABEL%%TAILORED_CHASE_SACRED%{%CORAL%Unidentified unique Sacred Armor%CL%%NAME%}
ItemDisplay[!TAILORED_GROUND_ED (uar UNI !ID !ETH GROUND FILTLVL<11)]:%TAILORED_CHASE_SACRED%{%CORAL%Unidentified unique Sacred Armor%CL%%NAME%}
ItemDisplay[(r33 OR r33s) GROUND FILTLVL<11 QTY>1]:%TAILORED_CHASE_ZOD% %YELLOW%x%QTY%{%TAN%Zod + Perfect Skull repairs an item%CL%%NAME%}
ItemDisplay[(r33 OR r33s) GROUND FILTLVL<11]:%TAILORED_CHASE_ZOD%{%TAN%Zod + Perfect Skull repairs an item%CL%%NAME%}
ItemDisplay[lsvl GROUND FILTLVL<11]:%TAILORED_CHASE_LIGHTSONG%{%NAME%}
ItemDisplay[llmr GROUND FILTLVL<11]:%TAILORED_CHASE_MIRROR%{%NAME%}

Alias[TAILORED_HELM]: (MAXSOCKETS>2 (ghm OR crn OR msk OR xhm OR xrn OR xsk OR dr1 OR dr2 OR dr3 OR dr4 OR dr5 OR ba1 OR ba2 OR ba3 OR ba4 OR ba5 OR ci2 OR ci3 OR ulm OR uhl OR usk OR uh9 OR dr6 OR dr7 OR dr8 OR dr9 OR dra OR ba6 OR ba7 OR ba8 OR ba9 OR baa OR drb OR drc OR drd OR dre OR drf OR bab OR bac OR bad OR (ETH (urn OR bae))))
// Jeweler's and +2 class skills occupy separate prefix groups.
Alias[TAILORED_CHEST]: (CHEST MAXSOCKETS>3 ALVL>74)
Alias[TAILORED_SHIELD]: (SHIELD MAXSOCKETS>3 ((DIN ALVL>54) OR (!DIN ALVL>64)))
// Rare weapon families use explicit normal, exceptional, and elite item codes.
// Ground-score displays cannot override this whitelist (v48 priority hide rule above).
// Champion Axe, Feral Axe, Glorious Axe, Giant Thresher, Thresher.
Alias[TAILORED_BASE_AXES_SCYTHES]: (gax OR 9ga OR 7ga OR lax OR 9la OR 7la OR gix OR 9gi OR 7gi OR wsc OR 9wc OR 7wc OR scy OR 9s8 OR 7s8)
// Berserker Axe, Colossus Blade, Thunder Maul, War Pike, Matriarchal Spear.
Alias[TAILORED_BASE_MELEE]: (wax OR 9wa OR 7wa OR gsd OR 9gd OR 7gd OR mau OR 9m9 OR 7m7 OR gma OR 9gm OR 7gm OR pik OR 9p9 OR 7p7 OR am3 OR am8 OR amd)
// Ghost Glaive, Winged Harpoon, Stygian Pilum, Balrog Spear, Matriarchal Javelin.
Alias[TAILORED_BASE_THROWING]: (7gl OR tsp OR 9ts OR 7ts OR pil OR 9pi OR 7pi OR ssp OR 9s9 OR 7s7 OR am5 OR ama OR amf)
// Matriarchal Bow, Grand Matron Bow, Demon Crossbow.
Alias[TAILORED_BASE_BOWS]: (am1 OR am6 OR amb OR am2 OR am7 OR amc OR rxb OR 8rx OR 6rx)
// Archon Staff, Caduceus, Lich Wand, Unearthed Wand, Truncheon, Tyrant Club.
Alias[TAILORED_BASE_CASTER]: (wst OR 8ws OR 6ws OR wsp OR 9ws OR 7ws OR bwn OR 9bw OR 7bw OR gwn OR 9gw OR 7gw OR clb OR 9cl OR 7cl OR spc OR 9sp OR 7sp)
// Heavenly Stone, Eldritch Orb, Demon Heart, Vortex Orb, Dimensional Shard.
Alias[TAILORED_BASE_ORBS]: (ob1 OR ob6 OR obb OR ob2 OR ob7 OR obc OR ob3 OR ob8 OR obd OR ob4 OR ob9 OR obe OR ob5 OR oba OR obf)
// Phase Blade, Scourge, Matriarchal Pike, and Great Poleaxe require ETH.
Alias[TAILORED_BASE_ETH_ONLY]: (ETH (crs OR 9cr OR 7cr OR fla OR 9fl OR 7fl OR am4 OR am9 OR ame OR hal OR 9h9 OR 7h7))
// Physical 400+ ED and 40 IAS eligibility; caster class/tree prefixes and staffmods.
Alias[TAILORED_WEAPON]: (WEAPON !SIN !leg !hst !msf ((!STAFF !WAND !SOR ALVL>55) OR ((STAFF OR SOR OR SCEPTER OR CLUB) ALVL>49) OR (WAND ALVL>59)))
// Low-strength gloves with a good defense-to-requirement tradeoff.
Alias[TAILORED_GLOVES]: (xvg OR ulg OR uvg)
// Rare of Acceleration (40 FRW) starts at affix level 51.
Alias[TAILORED_BOOTS]: (BOOTS ((!ID ALVL>50) OR (ID (FRW>39 OR (BOOTS FRW>29 (FRES+CRES+LRES+PRES>99) (MFIND>0 OR FHR>0 OR GFIND>0))))))
Alias[TAILORED_EXTRA_RARE]: ((amu ALVL>39) OR (QUIVER ALVL>39) OR jew)

ItemDisplay[RARE GROUND (NEC OR BELT OR rin OR SIN) !TAILORED_ID_KEEP_]:
ItemDisplay[RARE GROUND (WEAPON OR 7cr2) !(TAILORED_BASE_AXES_SCYTHES OR TAILORED_BASE_MELEE OR TAILORED_BASE_THROWING OR TAILORED_BASE_BOWS OR TAILORED_BASE_CASTER OR TAILORED_BASE_ORBS OR TAILORED_BASE_ETH_ONLY OR leg OR hst OR msf) !TAILORED_ID_KEEP_]:
ItemDisplay[RARE GROUND CHEST !TAILORED_CHEST !TAILORED_ID_KEEP_]:
ItemDisplay[RARE GROUND SHIELD !TAILORED_SHIELD !TAILORED_ID_KEEP_]:
ItemDisplay[RARE GROUND GLOVES !TAILORED_GLOVES !TAILORED_ID_KEEP_]:
ItemDisplay[RARE GROUND BOOTS !TAILORED_BOOTS !TAILORED_ID_KEEP_]:

