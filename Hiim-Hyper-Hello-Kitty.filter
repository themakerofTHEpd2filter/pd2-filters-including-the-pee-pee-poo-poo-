ItemDisplay[V22_SHOW_MAIN_ (STAT331>0 OR STAT335>0) STAT331>0 STAT335>0 FORMULAVLOSSCOLD>44]:%NAME%%CONTINUE%{%SAGE%Key mod%TAN%: %WHITE%+%STAT331%%PERCENT% Cold Skill Damage / -%STAT335%%PERCENT% enemy Cold resist%CL%%NAME%}
ItemDisplay[V22_SHOW_MAIN_ (STAT331>0 OR STAT335>0) STAT331>0 STAT335=0 FORMULAVLOSSCOLD>44]:%NAME%%CONTINUE%{%SAGE%Key mod%TAN%: %WHITE%+%STAT331%%PERCENT% Cold Skill Damage%CL%%NAME%}
ItemDisplay[V22_SHOW_MAIN_ (STAT331>0 OR STAT335>0) STAT331=0 STAT335>0 FORMULAVLOSSCOLD>44]:%NAME%%CONTINUE%{%SAGE%Key mod%TAN%: %WHITE%-%STAT335%%PERCENT% enemy Cold resist%CL%%NAME%}
