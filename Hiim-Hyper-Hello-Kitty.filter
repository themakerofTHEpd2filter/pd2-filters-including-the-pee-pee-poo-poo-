Formula[VRESPEAK]: MAX(FRES,LRES,CRES,PRES)
// v24: identified low-skill Sorceress orbs and staffs are hidden on ground. 2+ T4 remains visible.
ItemDisplay[GROUND ID (RARE OR MAG) (SOR OR STAFF) FORMULAV24SORCCORE=0 V15_T4_AT_LEAST_2_ FILTLVL~1-10]: %CORAL%[2+ T4] %NAME%
ItemDisplay[GROUND ID (RARE OR MAG) (SOR OR STAFF) FORMULAV24SORCCORE=0 FILTLVL~1-10 !TAILORED_ID_KEEP_]:
// v24: class skill synergies must lead. Otherwise FCR, ED, sockets, LAEK, MAEK cannot boost them into visible scores.
ItemDisplay[ID INVENTORY (RARE OR MAG) (SOR OR STAFF) FORMULAV24SORCCORE=0]: %NAME%%CONTINUE%{%TAN%Caster skill core missing: need +2 Sorc or +3 element AND +2 damaging staffmod%CL%%NAME%}
Alias[V22_SHOW_MAIN_]: (RARE TAILORED_SCORED_GEAR !SHOP FILTLVL>0 (FORMULARARECASTERHUNDREDTHS>249 OR FORMULARAREMELEEHUNDREDTHS>249))
ItemDisplay[V22_SHOW_MAIN_ FORMULAVHIGHSKILL>0 FORMULAVLOSSSKILL>44]:%NAME%%CONTINUE%{%SAGE%Key mod%TAN%: %WHITE%Skill levels up to +%FORMULAVHIGHSKILL%%CL%%NAME%}
ItemDisplay[V22_SHOW_MAIN_ FCR>0 FORMULAVLOSSCAST>44]:%NAME%%CONTINUE%{%SAGE%Key mod%TAN%: %WHITE%%FCR%%PERCENT% Faster Cast Rate%CL%%NAME%}
ItemDisplay[V22_SHOW_MAIN_ IAS>0 FORMULAVLOSSATTACK>44]:%NAME%%CONTINUE%{%SAGE%Key mod%TAN%: %WHITE%%IAS%%PERCENT% Increased Attack Speed%CL%%NAME%}
ItemDisplay[V22_SHOW_MAIN_ EDAM>0 FORMULAVLOSSDAMAGE>44]:%NAME%%CONTINUE%{%SAGE%Key mod%TAN%: %WHITE%%EDAM%%PERCENT% Enhanced Damage%CL%%NAME%}
ItemDisplay[V22_SHOW_MAIN_ (STAT329>0 OR STAT333>0) STAT329>0 STAT333>0 FORMULAVLOSSFIRE>44]:%NAME%%CONTINUE%{%SAGE%Key mod%TAN%: %WHITE%+%STAT329%%PERCENT% Fire Skill Damage / -%STAT333%%PERCENT% enemy Fire resist%CL%%NAME%}
ItemDisplay[V22_SHOW_MAIN_ (STAT329>0 OR STAT333>0) STAT329>0 STAT333=0 FORMULAVLOSSFIRE>44]:%NAME%%CONTINUE%{%SAGE%Key mod%TAN%: %WHITE%+%STAT329%%PERCENT% Fire Skill Damage%CL%%NAME%}
ItemDisplay[V22_SHOW_MAIN_ (STAT329>0 OR STAT333>0) STAT329=0 STAT333>0 FORMULAVLOSSFIRE>44]:%NAME%%CONTINUE%{%SAGE%Key mod%TAN%: %WHITE%-%STAT333%%PERCENT% enemy Fire resist%CL%%NAME%}
ItemDisplay[V22_SHOW_MAIN_ (STAT330>0 OR STAT334>0) STAT330>0 STAT334>0 FORMULAVLOSSLIGHT>44]:%NAME%%CONTINUE%{%SAGE%Key mod%TAN%: %WHITE%+%STAT330%%PERCENT% Lightning Skill Damage / -%STAT334%%PERCENT% enemy Lightning resist%CL%%NAME%}
ItemDisplay[V22_SHOW_MAIN_ (STAT330>0 OR STAT334>0) STAT330>0 STAT334=0 FORMULAVLOSSLIGHT>44]:%NAME%%CONTINUE%{%SAGE%Key mod%TAN%: %WHITE%+%STAT330%%PERCENT% Lightning Skill Damage%CL%%NAME%}
